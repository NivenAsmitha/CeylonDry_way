# ============================================
# Dependencies
# ============================================
node_modules/
frontend/node_modules/
backend/node_modules/

# ============================================
# Production builds
# ============================================
dist/
build/
frontend/dist/
backend/dist/

# ============================================
# Environment variables and secrets
# ============================================
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*

# Keep safe environment templates
!.env.example
!.env.*.example
!frontend/.env.example
!frontend/.env.*.example
!backend/.env.example
!backend/.env.*.example

# ============================================
# Testing and coverage
# ============================================
coverage/
frontend/coverage/
backend/coverage/
.nyc_output/

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
# Cache and temporary files
# ============================================
.cache/
.temp/
tmp/
*.tmp
*.tsbuildinfo
.eslintcache
.vite/

# ============================================
# Operating system files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# IDE files
# ============================================
.idea/
*.swp
*.swo

# VS Code personal settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# ============================================
# NestJS
# ============================================
backend/dist/

# ============================================
# Prisma local database files
# PostgreSQL is used, but this protects against
# accidentally committed local SQLite files.
# ============================================
*.db
*.db-journal
prisma/dev.db
backend/prisma/dev.db

# ============================================
# Uploaded development files
# ============================================
uploads/
backend/uploads/
